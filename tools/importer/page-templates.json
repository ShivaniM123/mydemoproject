          "selector": ".boxed-wrapper.mobile-reverse",
          "style": null,
          "blocks": [
            "columns-info"
          ],
          "defaultContent": []
        },
        {
          "id": "section-4",
          "name": "Call to Action",
          "selector": ".block-container-component.grid-box.classic.theme-blue:last-of-type",
          "style": null,
          "blocks": [],
          "defaultContent": [
            ".rte-styles.richtext.table-component.margin-bottom-30 > h2",
            ".button-component-wrapper.button-glms-alignment.center"
          ]
        }
      ]
    },
    {
      "name": "offers-page-es",
      "urls": [
        "https://www.sparkdriverapp.com/es_us/offers.html#offer-types"
      ],
      "description": "Spanish version of the Spark Driver offers page with offer types, additional delivery products, and CTA - same layout as en_us/offers.html",
      "blocks": [
        {
          "name": "hero",
          "instances": [
            ".columns-new-component.col-new-two#centered-split"
          ]
        },
        {
          "name": "offer-cards",
          "instances": [
            ".columns-new-component.col-new-three"
          ]
        },
        {
